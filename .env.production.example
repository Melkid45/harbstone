# Docker / reverse proxy
COMPOSE_PROJECT_NAME=harbstone
NEXT_IMAGE=harbstone-next:latest
STRAPI_IMAGE=harbstone-strapi:latest
FRONTEND_PORT=3003
STRAPI_PORT=1337
UPLOAD_MAX_FILE_SIZE_BYTES=1000000000

# Public domains
FRONTEND_URL=https://harbstone.digital
STRAPI_PUBLIC_URL=https://admin.harbstone.digital
NEXT_PUBLIC_STRAPI_URL=https://admin.harbstone.digital

# Next.js request form
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Harbstone <hello@harbstone.example.com>
REQUEST_TO_EMAIL=hello@harbstone.example.com

# Managed PostgreSQL
DATABASE_HOST=database-host
DATABASE_PORT=5432
DATABASE_NAME=database
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# Strapi secrets: generate unique random values for production
APP_KEYS=replace_key_1,replace_key_2,replace_key_3,replace_key_4
API_TOKEN_SALT=replace_me
ADMIN_JWT_SECRET=replace_me
TRANSFER_TOKEN_SALT=replace_me
JWT_SECRET=replace_me
ENCRYPTION_KEY=replace_me

# Comma-separated list, no spaces
CORS_ORIGINS=https://harbstone.example.com,https://www.harbstone.example.com

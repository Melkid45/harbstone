{
  "collectionName": "components_blocks_screens",
  "info": {
    "displayName": "Website Screens",
    "description": "One to three long website screenshots animated on scroll"
  },
  "options": {},
  "attributes": {
    "colorPicker": {
      "type": "customField",
      "customField": "global::colorPicker",
      "default": "#000",
      "regex": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "screens": {
      "type": "component",
      "component": "shared.website-screen",
      "repeatable": true,
      "required": true,
      "min": 1,
      "max": 3
    }
  }
}

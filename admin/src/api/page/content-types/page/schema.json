{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Localized pages assembled from reusable blocks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.showreel",
        "blocks.clients",
        "blocks.works-list",
        "blocks.services-list",
        "blocks.celebrities",
        "blocks.together",
        "blocks.about",
        "blocks.information",
        "blocks.reels",
        "blocks.timeline",
        "blocks.founder",
        "blocks.how-work",
        "blocks.team",
        "blocks.contacts",
        "blocks.eu-projects",
        "blocks.gallery",
        "blocks.idea"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
